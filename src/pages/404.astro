---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/ui';
---

<BaseLayout
  locale="id"
  title={`${t('id', '404.title')} | Rope Access Center`}
  description="Halaman yang Anda cari tidak ditemukan di situs Rope Access Center. Kembali ke beranda untuk melihat pelatihan dan layanan kami."
  path="/404/"
  alternates={[]}
  noindex
>
  <section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold text-heading">{t('id', '404.title')}</h1>
    <p class="mt-3 max-w-md text-muted">{t('id', '404.body')}</p>
    <p class="mt-1 max-w-md text-sm text-muted" lang="en">
      {t('en', '404.body')}
    </p>
    <a href="/" class="btn-dark mt-8">
      {t('id', '404.back')}
    </a>
  </section>
</BaseLayout>
