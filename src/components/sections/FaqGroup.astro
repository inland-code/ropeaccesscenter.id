---
/** FAQ dari src/content/data/faqs.json, difilter per grup. Teks yang sama dipakai FAQPage JSON-LD. */
import Icon from '@/components/icons/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { faqs } from '@/lib/data';
import { faqGroupLabel } from '@/lib/labels';
type Props = Extract<Section, { type: 'faq-group' }> & { locale: Locale; index: number };
const { eyebrow, title, intro, groups, grouped, limit, locale, index } = Astro.props;
const all = (await faqs(groups)).slice(0, limit ?? 99);
const blocks = grouped ? groups.map((g) => ({ group: g, items: all.filter((f) => f.data.group === g) })) : [{ group: '', items: all }];
---

{all.length > 0 && (
  <section class="bg-surface-alt py-20 sm:py-24">
    <div class="container-site max-w-4xl">
      <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
      {blocks
        .filter((b) => b.items.length)
        .map((b, bi) => (
          <div class="mt-10">
            {b.group && <h3 class="mb-4 text-xl font-bold text-heading">{faqGroupLabel[b.group]?.[locale]}</h3>}
            <div class="space-y-3">
              {b.items.map((f, i) => (
                <details
                  name={`faq-${index}-${bi}`}
                  open={i === 0 && bi === 0}
                  class="group rounded-xl bg-card ring-1 ring-line open:shadow-card"
                >
                  <summary class="flex cursor-pointer list-none items-center gap-4 px-6 py-5 text-lg font-semibold text-heading">
                    <span class="flex-1">{f.data.question[locale]}</span>
                    <Icon name="plus" class="size-5 shrink-0 text-brand-600 transition group-open:rotate-45" />
                  </summary>
                  <p class="px-6 pb-6 leading-relaxed text-muted">{f.data.answer[locale]}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
    </div>
  </section>
)}
