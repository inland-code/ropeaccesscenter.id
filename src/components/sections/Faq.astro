---
import Icon from '@/components/icons/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@/content.config';
type Props = Extract<Section, { type: 'faq' }> & { index: number };
const { eyebrow, title, intro, items, index } = Astro.props;
---

<section class="bg-surface-alt py-20 sm:py-24">
  <div class="container-site max-w-4xl">
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
    <div class="mt-10 space-y-3">
      {items.map((f, i) => (
        <details name={`faq-${index}`} open={i === 0} class="group rounded-xl bg-card ring-1 ring-line open:shadow-card">
          <summary class="flex cursor-pointer list-none items-center gap-4 px-6 py-5 text-lg font-semibold text-heading">
            <span class="flex-1">{f.q}</span>
            <Icon name="plus" class="size-5 shrink-0 text-brand-600 transition group-open:rotate-45" />
          </summary>
          <p class="px-6 pb-6 leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
