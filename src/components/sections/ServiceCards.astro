---
import Icon from '@/components/icons/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { resolveHref } from '@/lib/links';
type Props = Extract<Section, { type: 'service-cards' }> & { locale: Locale };
const { eyebrow, title, intro, items, locale } = Astro.props;
const cards = await Promise.all(
  items.map(async (it) => ({
    ...it,
    url: it.href ? await resolveHref(it.href, locale) : undefined,
    links: await Promise.all(it.links.map(async (l) => ({ ...l, url: await resolveHref(l.href, locale) }))),
  })),
);
---

<section class="py-20 sm:py-24">
  <div class="container-site">
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
    <div class:list={['mt-12 grid gap-6', cards.length >= 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3']}>
      {cards.map((c) => (
        <article class="group relative flex flex-col overflow-hidden rounded-card bg-brand-gradient p-7 text-white shadow-card transition duration-300 hover:-translate-y-1">
          <div
            class="pointer-events-none absolute -top-16 -right-16 size-48 rounded-full bg-white/10 transition duration-500 group-hover:scale-125"
            aria-hidden="true"
          ></div>
          {c.icon && (
            <span class="relative mb-6 inline-flex size-14 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/25 backdrop-blur">
              <Icon name={c.icon} class="size-7" />
            </span>
          )}
          <h3 class="relative text-xl font-bold">
            {c.url ? (
              <a href={c.url} class="after:absolute after:inset-0">
                {c.title}
              </a>
            ) : (
              c.title
            )}
          </h3>
          <p class="relative mt-3 text-[0.95rem] leading-relaxed text-white/90">{c.text}</p>
          {c.links.length > 0 && (
            <ul class="relative z-10 mt-6 space-y-2 border-t border-white/20 pt-5">
              {c.links.map((l) => (
                <li>
                  <a
                    href={l.url}
                    class="flex items-center justify-between gap-3 rounded-lg bg-white/10 px-4 py-2.5 text-sm font-medium transition hover:bg-white hover:text-brand-800"
                  >
                    {l.label}
                    <Icon name="arrow" class="size-4" />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
