---
/** Kartu otomatis dari halaman pelatihan (template "course") atau layanan (template "service"). */
import Icon from '@/components/icons/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { courseRoutes, serviceRoutes } from '@/lib/data';
import { resolveHref } from '@/lib/links';
type Props = Extract<Section, { type: 'page-cards' }> & { locale: Locale; currentPath?: string };
const { eyebrow, title, intro, of, featuredOnly, limit, cta, locale, currentPath } = Astro.props;

type Card = { href: string; title: string; text: string; icon: string; meta: string[]; badge?: string };
let cards: Card[] = [];
if (of === 'course') {
  cards = (await courseRoutes(locale))
    .filter((r) => !featuredOnly || r.entry.data.course.featured)
    .map((r) => {
      const c = r.entry.data.course;
      return {
        href: r.path,
        title: r.entry.data.hero.title,
        text: c.summary,
        icon: r.entry.data.card?.icon ?? 'graduation-cap',
        meta: c.duration ? [c.duration] : [],
        badge: c.code,
      };
    });
} else {
  cards = (await serviceRoutes(locale)).map((r) => ({
    href: r.path,
    title: r.entry.data.hero.title,
    text: r.entry.data.card?.summary ?? r.entry.data.seo.description,
    icon: r.entry.data.card?.icon ?? 'wrench',
    meta: [],
  }));
}
cards = cards.filter((c) => c.href !== currentPath).slice(0, limit ?? 99);
const ctaUrl = cta ? await resolveHref(cta.href, locale) : undefined;
const more = locale === 'id' ? 'Selengkapnya' : 'Learn more';
---

{cards.length > 0 && (
  <section class="py-20 sm:py-24">
    <div class="container-site">
      <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
      <div class:list={['mt-12 grid gap-6 sm:grid-cols-2', cards.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
        {cards.map((c) => (
          <article class="group relative flex flex-col rounded-card bg-card p-7 shadow-card ring-1 ring-line transition duration-300 hover:-translate-y-1 hover:ring-brand-600/40">
            <span
              class="absolute inset-x-0 top-0 h-1 rounded-t-card bg-brand-600 opacity-0 transition group-hover:opacity-100"
              aria-hidden="true"
            ></span>
            <div class="flex items-start justify-between gap-3">
              <span class="inline-flex size-12 items-center justify-center rounded-xl bg-navy-900 text-white">
                <Icon name={c.icon} class="size-6" />
              </span>
              {c.badge && (
                <span class="rounded-md bg-brand-50 px-2 py-1 font-display text-xs font-bold tracking-wider text-accent-strong">
                  {c.badge}
                </span>
              )}
            </div>
            <h3 class="mt-5 text-lg leading-snug font-bold text-heading">
              <a href={c.href} class="after:absolute after:inset-0">
                {c.title}
              </a>
            </h3>
            <p class="mt-3 line-clamp-4 text-[0.95rem] leading-relaxed text-muted">{c.text}</p>
            {c.meta.length > 0 && (
              <p class="mt-4 flex items-center gap-2 text-sm font-medium text-ink">
                <Icon name="clock" class="size-4 text-accent" />
                {c.meta.join(' · ')}
              </p>
            )}
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-accent-strong">
              {more} <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
            </span>
          </article>
        ))}
      </div>
      {cta && ctaUrl && (
        <p class="mt-10 text-center">
          <a href={ctaUrl} class="btn-dark">
            {cta.label} <Icon name="arrow" class="size-4" />
          </a>
        </p>
      )}
    </div>
  </section>
)}
