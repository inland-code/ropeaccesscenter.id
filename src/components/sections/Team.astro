---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { team } from '@/lib/data';
import { imageFor } from '@/lib/media';
type Props = Extract<Section, { type: 'team' }> & { locale: Locale };
const { eyebrow, title, intro, locale } = Astro.props;
const people = await team();
const initials = (n: string) =>
  n
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

{people.length > 0 && (
  <section class="bg-surface-alt py-20 sm:py-24">
    <div class="container-site">
      <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {people.map(({ data: p }) => (
          <article class="flex flex-col rounded-card bg-card p-6 shadow-card ring-1 ring-line">
            {p.photo ? (
              <Image src={imageFor(p.photo)} alt={p.name} width={160} height={160} class="size-20 rounded-full object-cover" />
            ) : (
              <span
                class="inline-flex size-20 items-center justify-center rounded-full bg-navy-900 font-display text-2xl font-bold text-white"
                aria-hidden="true"
              >
                {initials(p.name)}
              </span>
            )}
            <h3 class="mt-5 text-lg font-bold text-heading">{p.name}</h3>
            <p class="text-sm font-semibold text-accent-strong">{p.role[locale]}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{p.bio[locale]}</p>
            {p.credentials.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.credentials.map((c) => (
                  <li class="rounded-md bg-sand px-2 py-0.5 text-xs font-medium text-ink">{c}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
