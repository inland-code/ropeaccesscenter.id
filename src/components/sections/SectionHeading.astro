---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'center' | 'left';
  tone?: 'dark' | 'light';
}
const { eyebrow, title, intro, align = 'center', tone = 'dark' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && (
    <p class:list={['text-sm font-semibold tracking-[0.14em] uppercase', tone === 'dark' ? 'text-accent-strong' : 'text-brand-400']}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={['mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl', tone === 'dark' ? 'text-heading' : 'text-white']}>
    {title}
  </h2>
  {intro && <p class:list={['mt-4 text-lg text-pretty', tone === 'dark' ? 'text-muted' : 'text-white/85']}>{intro}</p>}
</div>
