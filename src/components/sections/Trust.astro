---
import Icon from '@/components/icons/Icon.astro';
import type { Section } from '@/content.config';
type Props = Extract<Section, { type: 'trust' }>;
const { items } = Astro.props;
---

<section class="relative z-10 -mt-px border-b border-line bg-card">
  <ul class="container-site grid gap-6 py-8 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((it) => (
      <li class="flex items-start gap-4">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
          <Icon name={it.icon} />
        </span>
        <div>
          <p class="font-semibold text-heading">{it.title}</p>
          <p class="mt-0.5 text-sm text-muted">{it.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
